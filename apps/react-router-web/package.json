{
  "name": "react-router-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "e2e:bootstrap": "node ../../scripts/bootstrap-playwright-supabase-user.mjs",
    "e2e:server": "node ./e2e-server.js",
    "test:e2e": "pnpm e2e:bootstrap && playwright test",
    "test:e2e:smoke": "pnpm e2e:bootstrap && playwright test --project=smoke",
    "test:e2e:integration": "pnpm e2e:bootstrap && playwright test --project=integration",
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "check-types": "react-router typegen && tsc",
    "clean": "rm -rf .react-router build"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@nichtsam/helmet": "0.3.3",
    "@react-router/fs-routes": "8.5.0",
    "@react-router/node": "8.5.0",
    "@react-router/serve": "8.5.0",
    "@repo/ui": "workspace:*",
    "@sentry/react-router": "11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tusbar/cache-control": "3.0.1",
    "dotenv": "^18.0.9",
    "isbot": "^5.2.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.0",
    "recharts": "^3.10.1",
    "remix-hook-form": "7.3.0",
    "remix-themes": "^2.0.4",
    "sonner": "^2.0.8",
    "spin-delay": "^2.0.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "5.0.5",
    "eslint": "10.13.0",
    "react-router-devtools": "6.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vite-env-only": "^3.0.3",
    "vitest": "5.0.5",
    "typescript7": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
