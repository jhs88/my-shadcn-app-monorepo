{
  "name": "react-router-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "e2e:bootstrap": "node ../../scripts/bootstrap-playwright-supabase-user.mjs",
    "e2e:server": "node ./e2e-server.js",
    "test:e2e": "pnpm e2e:bootstrap && playwright test",
    "test:e2e:smoke": "pnpm e2e:bootstrap && playwright test --project=smoke",
    "test:e2e:integration": "pnpm e2e:bootstrap && playwright test --project=integration",
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "check-types": "react-router typegen && tsc",
    "clean": "rm -rf .react-router build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@nichtsam/helmet": "0.3.0",
    "@react-router/fs-routes": "8.3.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@repo/ui": "workspace:*",
    "@sentry/react-router": "10.69.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "2.50.4",
    "@tusbar/cache-control": "1.0.2",
    "dotenv": "^17.4.2",
    "isbot": "^5.2.1",
    "lucide-react": "^0.475.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.71.1",
    "react-router": "8.3.0",
    "remix-hook-form": "7.1.1",
    "remix-themes": "^2.0.4",
    "sonner": "^2.0.7",
    "spin-delay": "^2.0.1",
    "tiny-invariant": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "8.3.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "4.1.10",
    "eslint": "~9.39.5",
    "react-router-devtools": "6.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-env-only": "^3.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
