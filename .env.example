# Local development needs no copied secrets: pnpm setup:local && pnpm dev:starter.
# These placeholders describe optional container/build configuration.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-your-local-publishable-or-anon-key
API_HOST=http://localhost:3001
JAVA_API_HOST=http://java-api:8080
# Container SSR must reach the host's local Supabase through host.docker.internal.
# Keep service-role keys out of frontend environment files and build arguments.
