{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "verify": "pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "scanner": "turbo scanner",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --affected && changeset publish",
    "update-types": "npx supabase gen types --lang=typescript --db-url \"$SUPABASE_DB_URL\" > packages/types/database.types.ts",
    "knip": "knip",
    "test:react-router-web:e2e": "pnpm --filter react-router-web test:e2e",
    "test:react-router-web:e2e:smoke": "pnpm --filter react-router-web test:e2e:smoke",
    "test:react-router-web:e2e:integration": "pnpm --filter react-router-web test:e2e:integration",
    "moon:build": "moon run :build",
    "moon:lint": "moon run :lint",
    "moon:test": "moon run :test",
    "moon:check-types": "moon run :check-types",
    "moon:verify": "moon run :lint :check-types :test :build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@moonrepo/cli": "2.4.6",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.10.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
