{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "node -e \"if (!process.env.CI && process.env.HUSKY !== '0' && process.env.NODE_ENV !== 'production' && require('node:fs').existsSync('.git')) import('husky').then(({ default: husky }) => husky())\"",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "verify": "pnpm test:tooling && pnpm lint && pnpm check-types && pnpm test && pnpm build",
    "scanner": "turbo scanner",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --affected && changeset publish",
    "update-types": "pnpm db:types",
    "knip": "knip",
    "test:react-router-web:e2e": "pnpm --filter react-router-web test:e2e",
    "test:react-router-web:e2e:smoke": "pnpm --filter react-router-web test:e2e:smoke",
    "test:react-router-web:e2e:integration": "pnpm --filter react-router-web test:e2e:integration",
    "moon:build": "moon run :build",
    "moon:lint": "moon run :lint",
    "moon:test": "moon run :test",
    "moon:check-types": "moon run :check-types",
    "moon:verify": "moon run :lint :check-types :test :build",
    "setup:local": "node scripts/local.mjs setup",
    "dev:starter": "node scripts/local.mjs dev",
    "dev:next": "node scripts/local.mjs dev web",
    "test:tooling": "node --test scripts/lib/*.test.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "verify:local": "node scripts/with-local-env.mjs pnpm verify",
    "test:containers": "node scripts/check-compose.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@moonrepo/cli": "2.6.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.22.1 || >=26.0.0"
  }
}
