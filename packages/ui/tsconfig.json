{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "inlineSourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@repo/ui/*": ["./src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "react", "react-dom"],
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
